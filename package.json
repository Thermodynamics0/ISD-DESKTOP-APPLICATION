{
  "name": "isd-desktop-application",
  "version": "0.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {},
  "devDependencies": {
    "concurrently": "^9.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^7.3.4"
  }
}